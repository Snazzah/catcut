{
	"name": "catcut",
	"short_name": "catcut",
	"id": "catcut",
	"description": "quick in-browser media editing with no uploads",
	"start_url": "/",
	"file_handlers": [
		{
			"action": "/",
			"name": "Audio or video file",
			"accept": {
				"audio/*": [
					".aac",
					".adts",
					".flac",
					".m4a",
					".mka",
					".mp3",
					".oga",
					".ogg",
					".opus",
					".wav",
					".weba"
				],
				"video/*": [
					".3g2",
					".3gp",
					".m2ts",
					".m4v",
					".mkv",
					".mov",
					".mp4",
					".mts",
					".ogv",
					".qt",
					".ts",
					".webm"
				]
			}
		}
	],
  "screenshots": [
    {
      "src": "/images/screenshots/desktop-main.png",
      "sizes": "1293x826",
      "type": "image/png",
      "form_factor": "wide"
    },
    {
      "src": "/images/screenshots/desktop-video.png",
      "sizes": "1293x826",
      "type": "image/png",
      "form_factor": "wide"
    },
    {
      "src": "/images/screenshots/desktop-audio.png",
      "sizes": "1293x826",
      "type": "image/png",
      "form_factor": "wide"
    }
	],
	"icons": [
		{
			"src": "/images/icon@128px.png",
			"sizes": "128x128",
			"type": "image/png"
		},
		{
			"src": "/images/icon@256px.png",
			"sizes": "256x256",
			"type": "image/png"
		},
		{
			"src": "/images/icon@512px.png",
			"sizes": "512x512",
			"type": "image/png"
		}
	],
	"theme_color": "#8b5cf6",
	"background_color": "#0a0a0a",
	"display": "standalone"
}
