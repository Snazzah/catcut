{
	"name": "catcut",
	"short_name": "catcut",
	"id": "catcut",
	"description": "quick in-browser media editing with no uploads",
	"start_url": "/",
	"share_target": {
		"action": "/?share-target=1",
		"method": "POST",
		"enctype": "multipart/form-data",
		"params": {
			"files": [{ "name": "media", "accept": ["video/*", "audio/*"] }]
		}
	},
	"file_handlers": [
		{
			"action": "/",
			"name": "Audio or video file",
			"accept": {
				"audio/*": [
					".aac",
					".adts",
					".flac",
					".m4a",
					".mka",
					".mp3",
					".oga",
					".ogg",
					".opus",
					".wav",
					".weba"
				],
				"video/*": [
					".3g2",
					".3gp",
					".m2ts",
					".m4v",
					".mkv",
					".mov",
					".mp4",
					".mts",
					".ogv",
					".qt",
					".ts",
					".webm"
				]
			}
		}
	],
  "screenshots": [
    {
      "src": "/images/screenshots/desktop-video.jpg",
      "sizes": "1920x1080",
      "type": "image/jpeg",
      "form_factor": "wide"
    },
    {
      "src": "/images/screenshots/desktop-video-editing.png",
      "sizes": "1920x1080",
      "type": "image/jpeg",
      "form_factor": "wide"
    },
    {
      "src": "/images/screenshots/desktop-audio.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide"
    },
    {
      "src": "/images/screenshots/desktop-audio-metadata.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide"
    },
    {
      "src": "/images/screenshots/mobile-audio.jpeg",
      "sizes": "1080x2101",
      "type": "image/jpeg",
      "form_factor": "narrow"
    },
    {
      "src": "/images/screenshots/mobile-audio-editing.jpeg",
      "sizes": "1080x2101",
      "type": "image/jpeg",
      "form_factor": "narrow"
    },
    {
      "src": "/images/screenshots/mobile-audio-metadata.jpeg",
      "sizes": "1080x2101",
      "type": "image/jpeg",
      "form_factor": "narrow"
    }
	],
	"icons": [
		{
			"src": "/images/icon@128px.png",
			"sizes": "128x128",
			"type": "image/png"
		},
		{
			"src": "/images/icon@256px.png",
			"sizes": "256x256",
			"type": "image/png"
		},
		{
			"src": "/images/icon@512px.png",
			"sizes": "512x512",
			"type": "image/png"
		}
	],
	"theme_color": "#8b5cf6",
	"background_color": "#0a0a0a",
	"display": "standalone"
}
